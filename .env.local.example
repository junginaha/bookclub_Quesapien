# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic AI (거인의 어깨 AI 대화, AI 발제 생성)
ANTHROPIC_API_KEY=sk-ant-...

# App — SEO/OG에 사용됩니다. 프로덕션에서는 실제 도메인으로 변경
NEXT_PUBLIC_SITE_URL=https://quesapience.com
# 로컬 개발 시: NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 이메일 (Resend - 향후 참가 확정 이메일 발송)
# RESEND_API_KEY=re_...

# 결제 (Stripe - 향후 멤버십 결제)
