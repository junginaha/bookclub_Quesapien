# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic AI (거인의 어깨 AI 대화, AI 발제 생성)
ANTHROPIC_API_KEY=sk-ant-...

# App — SEO/OG에 사용됩니다. 프로덕션에서는 실제 도메인으로 변경
NEXT_PUBLIC_SITE_URL=https://quesapience.com
# 로컬 개발 시: NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 이메일 (Resend - 향후 참가 확정 이메일 발송)
# RESEND_API_KEY=re_...

# 결제 (Stripe - 향후 멤버십 결제)
# STRIPE_SECRET_KEY=sk_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...

# 카카오 로그인 — REST API 키·Client Secret은 코드/env가 아니라
# Supabase Dashboard > Authentication > Providers > Kakao 에 등록합니다.
# 여기 .env에는 넣을 값이 없습니다 (하드코딩 금지).

# Sentry (무료 티어) — DSN은 비밀값이 아니라 공개해도 되는 식별자입니다.
# 비워두면 Sentry는 자동으로 비활성화됩니다(no-op).
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
# 아래 두 개는 빌드 시 소스맵 업로드용(선택, 없어도 에러 리포팅 자체는 동작):
# SENTRY_ORG=...
# SENTRY_PROJECT=...
# SENTRY_AUTH_TOKEN=...

# 최초 관리자 계정 부트스트랩 전용 (/api/admin/setup) — 필요할 때만 임시로 설정하고
# 사용 후 즉시 제거하세요. 호출 시 x-admin-key 헤더에 SUPABASE_SERVICE_ROLE_KEY 값을
# 그대로 넣어야 하며(별도 비밀번호 아님), 이 값은 여기서 설정한 임시 비밀번호가 됩니다.
# ADMIN_BOOTSTRAP_PASSWORD=
