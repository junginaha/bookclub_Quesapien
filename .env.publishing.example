# ── 19호실 출판OS 환경 변수 ──────────────────────────────────

# FastAPI 백엔드 URL (Next.js에서 프록시할 주소)
PUBLISHING_BACKEND_URL=http://localhost:8001

# Anthropic API 키 (AI 편집 도구용)
ANTHROPIC_API_KEY=sk-ant-api03-...

# 파일 업로드/출력 경로 (FastAPI)
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# FastAPI CORS 허용 도메인 (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:3000

# SQLite (개발) 또는 PostgreSQL (운영)
DATABASE_URL=sqlite+aiosqlite:///./publishing_os.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/publishing_os
